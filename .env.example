# ── Supabase ──────────────────────────────────────────────────────────────────
# Local dev (supabase start):  http://127.0.0.1:54321
# Production (Supabase Cloud):  https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Cloudflare Turnstile ─────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── SMTP (used by supabase/config.toml for auth emails in local dev) ─────────
GMAIL_SMTP_USER=
GMAIL_SMTP_PASSWORD=

# ── Misc ─────────────────────────────────────────────────────────────────────
DB_PASSWORD=
